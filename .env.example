# Puerto local/publicado. El servicio dentro de Docker escucha en 3005.
PORT=3005
HOST=127.0.0.1
# Conexión al MySQL de Compose desde npm start en el equipo.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=checkin_user
DB_PASSWORD=checkin_password
DB_NAME=checkin_db
DB_ROOT_PASSWORD=rootpassword
BROKER_URL=amqp://ticketu:ticketu_dev@ticketu-rabbitmq:5672/ticketu
EVENT_EXCHANGE=ticketu.events